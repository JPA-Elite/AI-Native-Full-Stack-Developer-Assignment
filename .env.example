# ---------------------------------------------------------------------------
# Local development needs no configuration.
# Documents and attachments are stored in .data/ajaia.db (SQLite via libSQL).
# ---------------------------------------------------------------------------
# DATABASE_URL=file:./.data/ajaia.db

# ---------------------------------------------------------------------------
# Production (Vercel) uses a free Turso database. Create one with:
#   turso db create ajaia-docs
#   turso db show ajaia-docs --url
#   turso db tokens create ajaia-docs
# Then add both variables in the Vercel project settings.
# ---------------------------------------------------------------------------
# DATABASE_URL=libsql://ajaia-docs-<org>.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...
